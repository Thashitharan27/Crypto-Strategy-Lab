.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local market data and generated reports are large/reproducible.
data/
cache/
output/
outputs/

# Canonical causal walk-forward state and experiment streams are runtime research data, not source.
walk_forward_state/
walk_forward_experiments/

# Local Data Lake research configs are user/run-specific and can be created freely.
# Keep the canonical repository smoke fixture tracked.
config/data_lake/*.json
!config/data_lake/BTCUSDT_4H_SMOKE.json
!config/data_lake/Photon_Structure_Parts_1_2.json
!config/data_lake/Photon_4H_Trend_1m.json
!config/data_lake/Photon_Zone_Reversal_1m.json

# Atomic Binance downloads can leave a temporary file if the desktop process is terminated.
data/.*.tmp

# Operator-local browser/data parity evidence; may contain run payloads and local provenance.
parity_verification/

# Separate non-production browser certification build; never ship with read-only dist.
browser_ui/dist-certification/
